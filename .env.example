POSTGRES_USER=job_portal
POSTGRES_PASSWORD=replace_with_a_long_password
POSTGRES_DB=job_portal
JWT_SECRET=replace_with_at_least_48_random_characters
PORT=3000
# Keep false for local HTTP. Set true when deployed behind HTTPS.
COOKIE_SECURE=false

# Direct employer ATS boards. Format: slug|Display Name,slug2|Display Name 2
JOB_GREENHOUSE_BOARDS=
JOB_LEVER_SITES=
JOB_ASHBY_BOARDS=
JOB_WORKABLE_ACCOUNTS=

JOB_REFRESH_MINUTES=360
JOB_RETENTION_DAYS=45

# Optional keyed providers
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
JOOBLE_API_KEY=

# Hagent recruiter + independent resume reviewer
HAGENT_URL=
HAGENT_TOKEN=
HAGENT_PROJECT_ID=
HAGENT_RECRUITER_AGENT_ID=
HAGENT_REVIEWER_AGENT_ID=

# Optional browser/ATS automation service. It must return a real confirmation
# reference before the portal records an application as submitted.
SUBMISSION_RUNNER_URL=
SUBMISSION_RUNNER_TOKEN=

# Optional AI bullet rewording in Career Ops. Leave the key empty to keep it off;
# everything else in Career Ops works without it. Users must opt in per request,
# and every suggestion is checked in code against hard rules before it is shown.
CAREEROPS_AI_KEY=
CAREEROPS_AI_MODEL=claude-sonnet-5-5
CAREEROPS_AI_URL=https://api.anthropic.com/v1/messages

# Forgot-password emails (SMTP). Any mail account works, e.g. Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false  SMTP_USER=you@gmail.com  SMTP_PASS=<app password>
# Leave SMTP_HOST empty to disable sending. For a private, owner-assisted setup you can set
# PASSWORD_RESET_LOG_LINKS=true to print reset links to the server log instead (anyone who can read
# the log could then reset that account, so keep it false when emails are configured).
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Job Portal <no-reply@example.com>
PASSWORD_RESET_LOG_LINKS=false
